---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Button from '@/components/ui/Button.astro';
import { prisma } from '@/lib/prisma';

const marcas = await prisma.marca.findMany({
  include: {
    modelos: { orderBy: { nombre: 'asc' } },
    _count: { select: { modelos: true } },
  },
  orderBy: { nombre: 'asc' },
});
---

<BaseLayout title="Marcas y Modelos — CelularES">
  <Header
    title="Marcas y Modelos"
    breadcrumbs={[
      { label: 'Dashboard', href: '/' },
      { label: 'Marcas y Modelos' },
    ]}
  />

  <main class="p-6 lg:p-8 max-w-5xl space-y-6 animate-fade-in">
    <!-- Add Brand Section -->
    <div class="card-surface p-5">
      <h2 class="text-base font-display font-bold mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Agregar Nueva Marca
      </h2>
      <form id="add-marca-form" class="flex items-end gap-3">
        <div class="flex-1 flex flex-col gap-1.5">
          <label for="nueva-marca" class="text-sm font-medium text-[var(--color-text-secondary)]">Nombre de la marca</label>
          <input
            type="text"
            id="nueva-marca"
            placeholder="Ej: Samsung, Apple, Motorola..."
            class="input-base"
            maxlength="50"
            required
          />
        </div>
        <Button type="submit" variant="primary" size="md" id="add-marca-btn">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Agregar
        </Button>
      </form>
    </div>

    <!-- Marcas List -->
    {marcas.length > 0 ? (
      <div class="space-y-4" id="marcas-container">
        {marcas.map((marca) => (
          <div class="card-surface overflow-hidden" data-marca-id={marca.id}>
            <!-- Marca Header -->
            <div class="marca-header flex items-center justify-between p-5 cursor-pointer" data-toggle-marca={marca.id}>
              <div class="flex items-center gap-3">
                <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-[oklch(from_var(--color-accent)_l_c_h_/_8%)]">
                  <svg class="w-5 h-5 text-[var(--color-accent)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
                </div>
                <div>
                  <h3 class="font-display font-bold text-[var(--color-text-primary)] marca-name-display">{marca.nombre}</h3>
                  <p class="text-xs text-[var(--color-text-secondary)]">{marca._count.modelos} {marca._count.modelos === 1 ? 'modelo' : 'modelos'}</p>
                </div>
              </div>
              <div class="flex items-center gap-1">
                <button type="button" class="action-btn edit-marca-btn" data-id={marca.id} data-nombre={marca.nombre} title="Editar marca">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                </button>
                <button type="button" class="action-btn action-btn-danger delete-marca-btn" data-id={marca.id} data-nombre={marca.nombre} title="Eliminar marca">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
                <div class="chevron-icon ml-1 transition-transform duration-200" data-chevron={marca.id}>
                  <svg class="w-4 h-4 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                </div>
              </div>
            </div>

            <!-- Modelos Panel -->
            <div class="modelos-panel border-t border-[var(--color-border-subtle)] hidden" data-modelos-panel={marca.id}>
              <div class="p-5 pt-4 space-y-3">
                <!-- Add Modelo -->
                <form class="add-modelo-form flex items-end gap-3" data-marca-id={marca.id}>
                  <div class="flex-1 flex flex-col gap-1.5">
                    <label class="text-sm font-medium text-[var(--color-text-secondary)]">Nuevo modelo para {marca.nombre}</label>
                    <input type="text" placeholder="Ej: Galaxy A54, iPhone 15..." class="input-base modelo-nombre-input" maxlength="100" required />
                  </div>
                  <Button type="submit" variant="secondary" size="sm">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Agregar
                  </Button>
                </form>

                <!-- Modelos List -->
                {marca.modelos.length > 0 ? (
                  <div class="modelos-list space-y-1">
                    {marca.modelos.map((modelo) => (
                      <div class="modelo-item flex items-center justify-between px-4 py-2.5 rounded-lg hover:bg-[var(--color-bg-elevated)] transition-colors group" data-modelo-id={modelo.id}>
                        <div class="flex items-center gap-3">
                          <div class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent-teal)]"></div>
                          <span class="text-sm text-[var(--color-text-primary)] modelo-name-display">{modelo.nombre}</span>
                        </div>
                        <div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                          <button type="button" class="action-btn action-btn-sm edit-modelo-btn" data-id={modelo.id} data-nombre={modelo.nombre} title="Editar">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                          </button>
                          <button type="button" class="action-btn action-btn-sm action-btn-danger delete-modelo-btn" data-id={modelo.id} data-nombre={modelo.nombre} title="Eliminar">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="text-sm text-[var(--color-text-muted)] text-center py-4">No hay modelos registrados para esta marca</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state py-16 card-surface">
        <svg class="w-14 h-14 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"><path d="M20 7h-9"/><path d="M14 17H5"/><circle cx="17" cy="17" r="3"/><circle cx="7" cy="7" r="3"/></svg>
        <p class="font-medium text-lg">No hay marcas registradas</p>
        <p class="text-sm text-[var(--color-text-muted)]">Comienza agregando marcas para organizar los modelos de celulares</p>
      </div>
    )}

    <!-- Summary info -->
    <div class="flex items-center justify-between text-sm text-[var(--color-text-secondary)] px-1">
      <p>{marcas.length} {marcas.length === 1 ? 'marca' : 'marcas'} registradas</p>
      <p>{marcas.reduce((acc, m) => acc + m._count.modelos, 0)} modelos en total</p>
    </div>
  </main>
</BaseLayout>

<style>
  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.15s;
  }
  .action-btn:hover {
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }
  .action-btn-sm {
    width: 1.75rem;
    height: 1.75rem;
  }
  .action-btn-danger:hover {
    background: oklch(from var(--color-danger) l c h / 12%);
    color: var(--color-danger);
  }

  .marca-header:hover {
    background: oklch(from var(--color-bg-elevated) l c h / 30%);
  }

  .chevron-icon.open {
    transform: rotate(180deg);
  }
</style>

<script>
  // ── Toggle marca accordion ──
  document.querySelectorAll('[data-toggle-marca]').forEach((header) => {
    header.addEventListener('click', (e) => {
      // Don't toggle if clicking action buttons
      const target = e.target as HTMLElement;
      if (target.closest('.action-btn')) return;

      const marcaId = (header as HTMLElement).dataset.toggleMarca!;
      const panel = document.querySelector(`[data-modelos-panel="${marcaId}"]`);
      const chevron = document.querySelector(`[data-chevron="${marcaId}"]`);

      panel?.classList.toggle('hidden');
      chevron?.classList.toggle('open');
    });
  });

  // ── Add marca ──
  const addMarcaForm = document.getElementById('add-marca-form') as HTMLFormElement;
  const nuevaMarcaInput = document.getElementById('nueva-marca') as HTMLInputElement;

  addMarcaForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = nuevaMarcaInput.value.trim();
    if (!nombre) return;

    try {
      const res = await fetch('/api/marcas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre }),
      });
      const json = await res.json();

      if (json.success) {
        (window as any).showToast(`Marca "${nombre}" creada`, 'success');
        setTimeout(() => window.location.reload(), 600);
      } else {
        throw new Error(json.error?.message);
      }
    } catch (err: any) {
      (window as any).showToast(err.message || 'Error al crear marca', 'error');
    }
  });

  // ── Add modelo ──
  document.querySelectorAll('.add-modelo-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const marcaId = (form as HTMLElement).dataset.marcaId!;
      const input = form.querySelector('.modelo-nombre-input') as HTMLInputElement;
      const nombre = input.value.trim();
      if (!nombre) return;

      try {
        const res = await fetch('/api/modelos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre, marcaId }),
        });
        const json = await res.json();

        if (json.success) {
          (window as any).showToast(`Modelo "${nombre}" agregado`, 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(json.error?.message);
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Error al crear modelo', 'error');
      }
    });
  });

  // ── Edit marca ──
  document.querySelectorAll('.edit-marca-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const currentName = el.dataset.nombre!;

      const newName = prompt('Nuevo nombre para la marca:', currentName);
      if (!newName || newName.trim() === currentName) return;

      try {
        const res = await fetch(`/api/marcas/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre: newName.trim() }),
        });
        const json = await res.json();

        if (json.success) {
          (window as any).showToast('Marca actualizada', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(json.error?.message);
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Error al actualizar', 'error');
      }
    });
  });

  // ── Delete marca ──
  document.querySelectorAll('.delete-marca-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const nombre = el.dataset.nombre!;

      const confirmed = await (window as any).confirmAction({
        title: '¿Eliminar marca?',
        message: `Se eliminará "${nombre}" y todos sus modelos asociados.`,
        confirmText: 'Eliminar',
      });
      if (!confirmed) return;

      try {
        const res = await fetch(`/api/marcas/${id}`, { method: 'DELETE' });
        const json = await res.json();

        if (json.success) {
          (window as any).showToast('Marca eliminada', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(json.error?.message);
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Error al eliminar', 'error');
      }
    });
  });

  // ── Edit modelo ──
  document.querySelectorAll('.edit-modelo-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const currentName = el.dataset.nombre!;

      const newName = prompt('Nuevo nombre del modelo:', currentName);
      if (!newName || newName.trim() === currentName) return;

      try {
        const res = await fetch(`/api/modelos/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nombre: newName.trim() }),
        });
        const json = await res.json();

        if (json.success) {
          (window as any).showToast('Modelo actualizado', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(json.error?.message);
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Error al actualizar', 'error');
      }
    });
  });

  // ── Delete modelo ──
  document.querySelectorAll('.delete-modelo-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const el = btn as HTMLElement;
      const id = el.dataset.id!;
      const nombre = el.dataset.nombre!;

      const confirmed = await (window as any).confirmAction({
        title: '¿Eliminar modelo?',
        message: `Se eliminará el modelo "${nombre}" permanentemente.`,
        confirmText: 'Eliminar',
      });
      if (!confirmed) return;

      try {
        const res = await fetch(`/api/modelos/${id}`, { method: 'DELETE' });
        const json = await res.json();

        if (json.success) {
          (window as any).showToast('Modelo eliminado', 'success');
          setTimeout(() => window.location.reload(), 600);
        } else {
          throw new Error(json.error?.message);
        }
      } catch (err: any) {
        (window as any).showToast(err.message || 'Error al eliminar', 'error');
      }
    });
  });
</script>
