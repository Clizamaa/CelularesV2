---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { prisma } from '@/lib/prisma';
import { formatDate } from '@/lib/utils/format';

// KPI Data
const [
  totalCelulares,
  celularesDisponibles,
  celularesAsignados,
  celularesMantenimiento,
  celularesEnBaja,
  totalBAM,
  bamDisponibles,
  bamAsignados,
  bamEnBaja,
  totalSimcards,
  simDisponibles,
  totalComputadores,
] = await Promise.all([
  prisma.celular.count({ where: { NOT: { estado: 'BAJA' } } }),
  prisma.celular.count({ where: { estado: 'DISPONIBLE' } }),
  prisma.celular.count({ where: { estado: 'ASIGNADO' } }),
  prisma.celular.count({ where: { estado: 'MANTENIMIENTO' } }),
  prisma.celular.count({ where: { estado: 'BAJA' } }),
  prisma.bAM.count({ where: { NOT: { estado: 'BAJA' } } }),
  prisma.bAM.count({ where: { estado: 'DISPONIBLE' } }),
  prisma.bAM.count({ where: { estado: 'ASIGNADO' } }),
  prisma.bAM.count({ where: { estado: 'BAJA' } }),
  prisma.simcard.count(),
  prisma.simcard.count({ where: { estado: 'DISPONIBLE' } }),
  prisma.computador.count(),
]);

const categories = [
  {
    title: 'Celulares',
    icon: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
    color: 'var(--color-accent)',
    stats: [
      { label: 'Activos', value: totalCelulares, sub: 'Total' },
      { label: 'Disponibles', value: celularesDisponibles, color: 'var(--color-status-disponible)' },
      { label: 'Asignados', value: celularesAsignados, color: 'var(--color-status-asignado)' },
      { label: 'Mantenimiento', value: celularesMantenimiento, color: 'var(--color-status-mantenimiento)' },
      { label: 'Bajas', value: celularesEnBaja, color: 'var(--color-danger)' },
    ]
  },
  {
    title: 'Banda Ancha Móvil',
    icon: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 4v4h6V4"/><line x1="9" y1="12" x2="15" y2="12"/></svg>',
    color: 'var(--color-accent-teal)',
    stats: [
      { label: 'Activos', value: totalBAM, sub: 'Total' },
      { label: 'Disponibles', value: bamDisponibles, color: 'var(--color-status-disponible)' },
      { label: 'Asignados', value: bamAsignados, color: 'var(--color-status-asignado)' },
      { label: 'Bajas', value: bamEnBaja, color: 'var(--color-danger)' },
    ]
  },
  {
    title: 'Infraestructura SIM & Otros',
    icon: '<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>',
    color: 'var(--color-accent-blue)',
    stats: [
      { label: 'Simcards', value: totalSimcards, sub: `${simDisponibles} dispon.` },
      { label: 'Computadores', value: totalComputadores, sub: 'All In One' },
    ]
  }
];

const quickActions = [
  { label: 'Nuevo Celular', href: '/celulares/nuevo', icon: '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>', color: 'var(--color-accent)' },
  { label: 'Nueva BAM', href: '/bam/nuevo', icon: '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>', color: 'var(--color-accent-teal)' },
  { label: 'Simcards', href: '/simcards', icon: '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 4v4h6V4"/><line x1="9" y1="12" x2="15" y2="12"/></svg>', color: 'var(--color-accent-blue)' },
  { label: 'Mantenedores', href: '/mantenedores', icon: '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>', color: 'var(--color-text-muted)' },
];
---

<BaseLayout title="Dashboard — CelularES">
  <Header title="Dashboard" />

  <main class="p-6 lg:p-8 space-y-10 animate-fade-in">
    <!-- Top Compact Quick Actions -->
    <div class="flex flex-wrap items-center gap-3 pb-2">
        <span class="text-[10px] font-black uppercase tracking-widest text-[var(--color-text-muted)] border-r border-[var(--color-border-subtle)] pr-4 mr-1">Accesos Rápidos</span>
        <div class="flex flex-wrap gap-2">
            {quickActions.map(action => (
                <a href={action.href} class="flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)] hover:border-[oklch(from_var(--color-text-primary)_l_c_h_/_20%)] hover:translate-y-[-1px] transition-all duration-300 group shadow-sm">
                    <div class="flex items-center justify-center w-7 h-7 rounded-lg text-white shadow-sm" style={`background-color: ${action.color}`} set:html={action.icon} />
                    <span class="text-xs font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors">{action.label}</span>
                </a>
            ))}
        </div>
    </div>

    <!-- Categorized Sections -->
    <div class="space-y-10">
      {categories.map((cat, catIdx) => (
        <section class="space-y-5">
           <div class="flex items-center gap-3">
              <div class="flex items-center justify-center w-10 h-10 rounded-2xl bg-[var(--color-bg-elevated)] border border-[var(--color-border-subtle)] shadow-sm" style={`color: ${cat.color}`} set:html={cat.icon} />
              <h2 class="text-xl font-display font-bold text-[var(--color-text-primary)]">{cat.title}</h2>
              <div class="h-px flex-1 bg-gradient-to-r from-[var(--color-border-subtle)] to-transparent ml-2"></div>
           </div>

           <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 lg:gap-6">
              {cat.stats.map((stat, i) => (
                <div class="group card-surface p-5 lg:p-6 relative overflow-hidden transition-all duration-300 hover:shadow-xl hover:translate-y-[-2px] animate-slide-up" style={`animation-delay: ${(catIdx * 100) + (i * 50)}ms`}>
                  <div class="absolute top-0 left-0 w-1 h-full opacity-10 group-hover:opacity-100 transition-opacity" style={`background-color: ${stat.color || cat.color}`}></div>
                  
                  <div class="space-y-1 relative z-10">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-[var(--color-text-muted)] group-hover:text-[var(--color-text-secondary)] transition-colors">{stat.label}</p>
                    <p class="text-3xl font-display font-black leading-none" style={`color: ${stat.color || 'var(--color-text-primary)'}`}>
                      {stat.value}
                    </p>
                    {stat.sub && (
                      <p class="text-[10px] text-[var(--color-text-muted)] font-medium mt-1">{stat.sub}</p>
                    )}
                  </div>

                  <div class="absolute -bottom-2 -right-2 opacity-[0.03] group-hover:opacity-[0.07] transition-opacity rotate-12 scale-150 pointer-events-none" style={`color: ${cat.color}`} set:html={cat.icon} />
                </div>
              ))}
           </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
