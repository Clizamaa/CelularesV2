---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { prisma } from '@/lib/prisma';
import { formatDate } from '@/lib/utils/format';

// KPI Data
const [
  totalCelulares,
  disponibles,
  asignados,
  mantenimiento,
  enBaja,
  totalSimcards,
  simDisponibles,
  totalComputadores,
  ultimasAsignaciones,
] = await Promise.all([
  prisma.celular.count(),
  prisma.celular.count({ where: { estado: 'DISPONIBLE' } }),
  prisma.celular.count({ where: { estado: 'ASIGNADO' } }),
  prisma.celular.count({ where: { estado: 'MANTENIMIENTO' } }),
  prisma.celular.count({ where: { estado: 'BAJA' } }),
  prisma.simcard.count(),
  prisma.simcard.count({ where: { estado: 'DISPONIBLE' } }),
  prisma.computador.count(),
  prisma.asignacion.findMany({
    where: { activa: true },
    take: 5,
    orderBy: { fechaAsignacion: 'desc' },
    include: { celular: true, simcard: true },
  }),
]);

const kpis = [
  {
    label: 'Total Celulares',
    value: totalCelulares,
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>',
    color: 'var(--color-accent)',
    bg: 'oklch(from var(--color-accent) l c h / 10%)',
  },
  {
    label: 'Disponibles',
    value: disponibles,
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>',
    color: 'var(--color-status-disponible)',
    bg: 'oklch(from var(--color-status-disponible) l c h / 10%)',
  },
  {
    label: 'Asignados',
    value: asignados,
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>',
    color: 'var(--color-status-asignado)',
    bg: 'oklch(from var(--color-status-asignado) l c h / 10%)',
  },
  {
    label: 'Mantenimiento',
    value: mantenimiento,
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
    color: 'var(--color-status-mantenimiento)',
    bg: 'oklch(from var(--color-status-mantenimiento) l c h / 10%)',
  },
];
---

<BaseLayout title="Dashboard — CelularES">
  <Header title="Dashboard" />

  <main class="p-6 lg:p-8 space-y-8 animate-fade-in">
    <!-- KPI Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6">
      {kpis.map((kpi, i) => (
        <div class="card-surface p-5 lg:p-6 animate-slide-up" style={`animation-delay: ${i * 60}ms`}>
          <div class="flex items-start justify-between">
            <div class="space-y-2">
              <p class="text-sm text-[var(--color-text-secondary)]">{kpi.label}</p>
              <p class="text-3xl lg:text-4xl font-display font-bold" style={`color: ${kpi.color}`}>
                {kpi.value}
              </p>
            </div>
            <div
              class="flex items-center justify-center w-12 h-12 rounded-xl"
              style={`background: ${kpi.bg}; color: ${kpi.color}`}
              set:html={kpi.icon}
            />
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
      <div class="card-surface p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[oklch(from_var(--color-accent-teal)_l_c_h_/_10%)]">
            <svg class="w-4.5 h-4.5 text-[var(--color-accent-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 4v4h6V4"/><line x1="9" y1="12" x2="15" y2="12"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[var(--color-text-primary)]">SIM Cards</p>
            <p class="text-xs text-[var(--color-text-muted)]">Total en el sistema</p>
          </div>
        </div>
        <div class="flex items-end justify-between">
          <p class="text-2xl font-display font-bold text-[var(--color-accent-teal)]">{totalSimcards}</p>
          <p class="text-xs text-[var(--color-text-secondary)]">{simDisponibles} disponibles</p>
        </div>
      </div>

      <div class="card-surface p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[oklch(from_sky_500_l_c_h_/_10%)]">
            <svg class="w-4.5 h-4.5 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[var(--color-text-primary)]">Computadores</p>
            <p class="text-xs text-[var(--color-text-muted)]">All In One (AIO)</p>
          </div>
        </div>
        <div class="flex items-end justify-between">
          <p class="text-2xl font-display font-bold text-sky-500">{totalComputadores}</p>
          <a href="/computadores" class="text-[10px] font-bold uppercase tracking-wider text-[var(--color-text-muted)] hover:text-sky-500 transition-colors">Ver todos →</a>
        </div>
      </div>

      <div class="card-surface p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-[oklch(from_var(--color-danger)_l_c_h_/_10%)]">
            <svg class="w-4.5 h-4.5 text-[var(--color-danger)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <div>
            <p class="text-sm font-medium text-[var(--color-text-primary)]">Dados de Baja</p>
            <p class="text-xs text-[var(--color-text-muted)]">Equipos inactivos</p>
          </div>
        </div>
        <p class="text-2xl font-display font-bold text-[var(--color-danger)]">{enBaja}</p>
      </div>

      <div class="card-surface p-5 flex flex-col justify-between">
        <p class="text-sm font-medium text-[var(--color-text-secondary)] mb-3">Acciones Rápidas</p>
        <div class="flex flex-col gap-2">
          <Button href="/computadores/nuevo" variant="primary" size="sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo AIO
          </Button>
          <Button href="/celulares/nuevo" variant="secondary" size="sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo Celular
          </Button>
        </div>
      </div>
    </div>

    <!-- Last Assignments Table -->
    <div class="card-surface overflow-hidden">
      <div class="flex items-center justify-between p-5 pb-0">
        <div>
          <h2 class="text-lg font-display font-bold">Últimas Asignaciones</h2>
          <p class="text-sm text-[var(--color-text-secondary)] mt-0.5">Asignaciones activas más recientes</p>
        </div>
        <Button href="/celulares" variant="ghost" size="sm">Ver todo</Button>
      </div>

      {ultimasAsignaciones.length > 0 ? (
        <div class="overflow-x-auto mt-4">
          <table class="data-table">
            <thead>
              <tr>
                <th>Equipo</th>
                <th>Serial</th>
                <th>SIM</th>
                <th>Funcionario</th>
                <th>Fecha</th>
              </tr>
            </thead>
            <tbody>
              {ultimasAsignaciones.map((a) => (
                <tr>
                  <td>
                    <div class="flex flex-col">
                      <span class="font-medium text-[var(--color-text-primary)]">{a.celular.marca}</span>
                      <span class="text-xs text-[var(--color-text-secondary)]">{a.celular.modelo}</span>
                    </div>
                  </td>
                  <td class="font-mono text-sm text-[var(--color-text-secondary)]">{a.celular.serial}</td>
                  <td>
                    {a.simcard ? (
                      <span class="text-sm">{a.simcard.numeroTelefono || a.simcard.numeroSimcard}</span>
                    ) : (
                      <span class="text-sm text-[var(--color-text-muted)]">—</span>
                    )}
                  </td>
                  <td class="text-sm">{a.funcionarioNombre || <span class="text-[var(--color-text-muted)]">Sin asignar</span>}</td>
                  <td class="text-sm text-[var(--color-text-secondary)]">{formatDate(a.fechaAsignacion)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state py-12">
          <svg class="w-12 h-12 text-[var(--color-text-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          <p class="font-medium">No hay asignaciones activas</p>
          <p class="text-sm text-[var(--color-text-muted)]">Las asignaciones aparecerán aquí cuando se creen</p>
        </div>
      )}
    </div>
  </main>
</BaseLayout>
