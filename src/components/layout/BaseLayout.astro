---
import Sidebar from './Sidebar.astro';
import Toast from '../ui/Toast.astro';
import ConfirmDialog from '../ui/ConfirmDialog.astro';
import BarcodeScanner from '../ui/BarcodeScanner.astro';
import CameraScanner from '../ui/CameraScanner.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = 'CelularES — Sistema de Inventario',
  description = 'Sistema de gestión e inventario de celulares corporativos',
  currentPath = Astro.url.pathname,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Sidebar currentPath={currentPath} />

  <div class="main-wrapper">
    <slot />
  </div>

  <Toast />
  <ConfirmDialog />
  <BarcodeScanner />
  <CameraScanner />

  <style>
    .main-wrapper {
      margin-left: var(--spacing-sidebar);
      min-height: 100dvh;
    }

    @media (max-width: 1023px) {
      .main-wrapper {
        margin-left: 0;
      }
    }
  </style>
</body>
</html>
