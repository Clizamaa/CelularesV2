---
interface Props {
  label: string;
  name: string;
  type?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  disabled?: boolean;
  error?: string;
  helper?: string;
  maxlength?: number;
  class?: string;
  id?: string;
  pattern?: string;
  min?: string;
  max?: string;
}

const {
  label,
  name,
  type = 'text',
  placeholder = '',
  value = '',
  required = false,
  disabled = false,
  error = '',
  helper = '',
  maxlength,
  class: className = '',
  id,
  pattern,
  min,
  max,
} = Astro.props;

const inputId = id || `input-${name}`;
---

<div class={`flex flex-col gap-1.5 ${className}`}>
  <label for={inputId} class="text-sm font-medium text-[var(--color-text-secondary)]">
    {label}
    {required && <span class="text-[var(--color-danger)] ml-0.5">*</span>}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={inputId}
      name={name}
      placeholder={placeholder}
      required={required}
      disabled={disabled}
      maxlength={maxlength}
      class={`input-base resize-none min-h-[5rem] ${error ? 'input-error' : ''}`}
    >{value}</textarea>
  ) : type === 'select' ? (
    <select
      id={inputId}
      name={name}
      required={required}
      disabled={disabled}
      class={`input-base ${error ? 'input-error' : ''}`}
    >
      <slot />
    </select>
  ) : (
    <input
      id={inputId}
      name={name}
      type={type}
      placeholder={placeholder}
      value={value}
      required={required}
      disabled={disabled}
      maxlength={maxlength}
      pattern={pattern}
      min={min}
      max={max}
      class={`input-base ${error ? 'input-error' : ''}`}
    />
  )}

  {error && (
    <p class="text-xs text-[var(--color-danger)] flex items-center gap-1">
      <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      {error}
    </p>
  )}

  {helper && !error && (
    <p class="text-xs text-[var(--color-text-muted)]">{helper}</p>
  )}

  {maxlength && type === 'textarea' && (
    <p class="text-xs text-[var(--color-text-muted)] text-right char-counter" data-max={maxlength}>
      {value.length}/{maxlength}
    </p>
  )}
</div>
